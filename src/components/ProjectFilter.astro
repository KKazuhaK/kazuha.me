---
import { getLocale, t, type UiKey } from '../i18n/ui';

const locale = getLocale(Astro.currentLocale);
const kinds = ['all', 'oss', 'research', 'infra'] as const;
---

<!-- Hidden until the script runs; without JS every project stays visible. -->
<div
  class="filter"
  role="group"
  aria-label={t(locale, 'filterLabel')}
  hidden
  data-project-filter
>
  {kinds.map((kind) => (
    <button
      type="button"
      data-kind={kind}
      aria-pressed={kind === 'all' ? 'true' : 'false'}
    >
      {t(locale, kind === 'all' ? 'filterAll' : (`kind_${kind}` as UiKey))}
    </button>
  ))}
</div>
<p
  class="visually-hidden"
  role="status"
  aria-live="polite"
  data-filter-status
  data-many={t(locale, 'showingProjects')}
  data-one={t(locale, 'showingOneProject')}
></p>

<script>
  const filter = document.querySelector<HTMLElement>('[data-project-filter]');
  const status = document.querySelector<HTMLElement>('[data-filter-status]');
  const items = document.querySelectorAll<HTMLElement>(
    '[data-project-grid] [data-kind]',
  );

  if (filter) {
    filter.hidden = false;
    const buttons = filter.querySelectorAll<HTMLButtonElement>('button');
    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const kind = button.dataset.kind;
        buttons.forEach((b) =>
          b.setAttribute('aria-pressed', String(b === button)),
        );
        let shown = 0;
        items.forEach((item) => {
          item.hidden = kind !== 'all' && item.dataset.kind !== kind;
          if (!item.hidden) shown += 1;
        });
        if (status) {
          const template =
            shown === 1 ? status.dataset.one : status.dataset.many;
          status.textContent = (template ?? '').replace('{n}', String(shown));
        }
      });
    });
  }
</script>

<style>
  .filter {
    flex-wrap: wrap;
    gap: var(--space-1);
  }
  .filter:not([hidden]) {
    display: flex;
    margin: var(--space-3) 0;
  }
  button {
    min-height: var(--control-height);
    padding: 0 18px;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-pill);
    background: var(--surface);
    color: var(--text-2);
    font-size: 15px;
    font-weight: 500;
    cursor: pointer;
  }
  button:hover {
    background: var(--surface-hover);
  }
  button[aria-pressed='true'] {
    background: var(--text);
    border-color: var(--text);
    color: var(--surface);
  }
</style>
