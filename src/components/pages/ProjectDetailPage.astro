---
import Arrow from '../Arrow.astro';
import { render } from 'astro:content';
import ArchDiagram from '../ArchDiagram.astro';
import Breadcrumb from '../Breadcrumb.astro';
import FallbackNotice from '../FallbackNotice.astro';
import LinkButton from '../LinkButton.astro';
import ProseLink from '../ProseLink.astro';
import Prose from '../Prose.astro';
import ProjectMeta from '../ProjectMeta.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { resolveUrl } from '../../config/resolve';
import { getProject } from '../../i18n/content';
import { fallbackLang, getLocale, localizedPath, t } from '../../i18n/ui';

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const locale = getLocale(Astro.currentLocale);
const found = await getProject(locale, slug);
if (!found) throw new Error(`Unknown project: ${slug}`);

const { project, previous, next } = found;
const translated = (await getProject('zh', slug))?.project.fallback === false;
const contentLang = project.fallback ? fallbackLang(locale) : undefined;
const { data } = project.entry;
const { Content } = await render(project.entry);
const github = resolveUrl(data.links.github);
const demo = resolveUrl(data.links.demo);
const listHref = localizedPath(locale, '/projects');

function projectHref(s: string) {
  return localizedPath(locale, `/projects/${s}`);
}
---

<BaseLayout title={data.title} description={data.summary} {translated}>
  <article class="project">
    <Breadcrumb
      items={[
        { label: t(locale, 'projectsTitle'), href: '/projects' },
        { label: data.title, lang: contentLang },
      ]}
    />
    <h1 lang={contentLang}>{data.title}</h1>
    <p class="summary" lang={contentLang}>
      {data.summary}
    </p>
    {project.fallback && <FallbackNotice />}
    <ProjectMeta
      role={data.role}
      year={data.year}
      stack={data.stack}
      status={data.status}
      fallback={project.fallback}
    />
    <div class="actions">
      {github && (
        <LinkButton href={github} variant="primary">
          {t(locale, 'viewSource')}
        </LinkButton>
      )}
      {demo && (
        <LinkButton href={demo} variant="primary">
          {t(locale, 'visitSite')}
        </LinkButton>
      )}
      <LinkButton href={listHref} variant="secondary">
        <Arrow dir="left" />
        {t(locale, 'backToProjects')}
      </LinkButton>
    </div>

    <div class="body" lang={contentLang}>
      <Prose>
        <Content components={{ ArchDiagram, a: ProseLink }} />
      </Prose>
    </div>

    <nav class="pager" aria-label={t(locale, 'moreProjects')}>
      {previous && (
        <a class="prev" href={projectHref(previous.slug)}>
          <span class="dir">
            <Arrow dir="left" size={15} />
            {t(locale, 'previousProject')}
          </span>
          <span
            class="name"
            lang={previous.fallback ? fallbackLang(locale) : undefined}
          >
            {previous.entry.data.title}
          </span>
        </a>
      )}
      {next && (
        <a class="next" href={projectHref(next.slug)}>
          <span class="dir">
            {t(locale, 'nextProject')}
            <Arrow size={15} />
          </span>
          <span
            class="name"
            lang={next.fallback ? fallbackLang(locale) : undefined}
          >
            {next.entry.data.title}
          </span>
        </a>
      )}
    </nav>
  </article>
</BaseLayout>

<style>
  .project {
    max-width: 820px;
    margin: 0 auto;
  }
  h1 {
    margin: var(--space-1) 0 var(--space-2);
    font-size: 48px;
  }
  .summary {
    margin-bottom: var(--space-3);
    font-size: 18px;
    color: var(--text-2);
  }
  .project :global(.notice) {
    margin-bottom: var(--space-3);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: var(--space-3) 0;
  }
  .body {
    margin-top: var(--space-5);
  }
  .pager {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-2);
    margin-top: var(--space-6);
  }
  .pager a {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: var(--space-2) var(--space-3);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
  }
  .pager a:hover {
    border-color: var(--accent);
  }
  .next {
    grid-column: 2;
    align-items: flex-end;
    text-align: right;
  }
  .dir {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 14px;
    color: var(--accent);
    font-weight: 600;
  }
  .name {
    font-family: var(--font-serif);
    font-size: 24px;
  }
  @media (max-width: 859.98px) {
    h1 {
      font-size: 38px;
    }
    .pager {
      grid-template-columns: 1fr;
    }
    .next {
      grid-column: 1;
    }
  }
</style>
