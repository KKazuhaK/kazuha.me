---
import { getCollection } from 'astro:content';
import Breadcrumb from '../Breadcrumb.astro';
import FallbackNotice from '../FallbackNotice.astro';
import LinkGroup from '../LinkGroup.astro';
import LinkRow from '../LinkRow.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { displayUrl, isExternalUrl, resolveUrl } from '../../config/resolve';
import { site } from '../../config/site';
import {
  fallbackLang,
  getLocale,
  localizedPath,
  t,
  type UiKey,
} from '../../i18n/ui';

const locale = getLocale(Astro.currentLocale);
const groups = ['school', 'sites', 'code', 'contact'] as const;

// Rows whose URL is still a placeholder are dropped.
const rows = (await getCollection('links'))
  .map((e) => e.data)
  .filter((item) => item.enabled)
  .sort((a, b) => a.order - b.order)
  .flatMap((item) => {
    const resolved = resolveUrl(item.url);
    if (!resolved) return [];
    // Site paths such as /notes stay on this site, in the current language.
    const internal = resolved.startsWith('/');
    const href = internal ? localizedPath(locale, resolved) : resolved;
    const display =
      item.display ?? displayUrl(internal ? site.url + href : resolved);
    return [{ ...item, href, display }];
  });

const title = t(locale, 'linksTitle');
const intro = t(locale, 'linksIntro');
---

<BaseLayout {title} description={intro}>
  <div class="links">
    <div class="head">
      <Breadcrumb items={[{ label: t(locale, 'nav_links') }]} />
      <h1>{title}</h1>
      <p class="intro">{intro}</p>
    </div>
    {locale !== 'en' && <FallbackNotice />}
    {groups.map((group) => {
      const items = rows.filter((r) => r.group === group);
      return (
        items.length > 0 && (
          <LinkGroup title={t(locale, `group_${group}` as UiKey)}>
            {items.map((item) => (
              <LinkRow
                href={item.href}
                name={item.name}
                sub={item.sub}
                display={item.display}
                mark={item.mark}
                cta={item.cta}
                group={item.group}
                lang={fallbackLang(locale)}
                external={isExternalUrl(item.href)}
              />
            ))}
          </LinkGroup>
        )
      );
    })}
  </div>
</BaseLayout>

<style>
  .links {
    max-width: 820px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }
  h1 {
    margin-top: var(--space-1);
    font-size: 48px;
  }
  .intro {
    margin-top: 12px;
    font-size: 17px;
    color: var(--text-2);
  }
  @media (max-width: 859.98px) {
    h1 {
      font-size: 38px;
    }
  }
</style>
