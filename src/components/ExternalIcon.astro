---
import { getLocale, t } from '../i18n/ui';

interface Props {
  size?: number;
}
const { size = 14 } = Astro.props;
const locale = getLocale(Astro.currentLocale);
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <path d="M7 17L17 7M9 7h8v8"></path>
</svg>
<span class="visually-hidden"> {t(locale, 'opensNewTab')}</span>
