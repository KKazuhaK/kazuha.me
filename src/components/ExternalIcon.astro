---
import { ArrowUpRight } from '@lucide/astro';
import { getLocale, t } from '../i18n/ui';

interface Props {
  size?: number;
}
const { size = 14 } = Astro.props;
const locale = getLocale(Astro.currentLocale);
---

<ArrowUpRight {size} stroke-width={2.25} class="arrow-icon external" />
<span class="visually-hidden"> {t(locale, 'opensNewTab')}</span>
