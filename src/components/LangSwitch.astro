---
import { Globe } from '@lucide/astro';
import {
  getLocale,
  localizedPath,
  pathInLocale,
  t,
  type Locale,
} from '../i18n/ui';

interface Props {
  class?: string;
  /** On 404 pages, link to the other locale's home instead of the same path. */
  notFound?: boolean;
}

const { class: className, notFound = false } = Astro.props;
const locale = getLocale(Astro.currentLocale);

// A single quiet link to the other language; English stays the default.
const target: { code: Locale; label: string; lang: string } =
  locale === 'en'
    ? { code: 'zh', label: t(locale, 'langZh'), lang: 'zh-Hans' }
    : { code: 'en', label: t(locale, 'langEn'), lang: 'en' };
---

<a
  class:list={['lang', className]}
  href={
    notFound
      ? localizedPath(target.code, '/')
      : pathInLocale(Astro.url.pathname, target.code)
  }
  hreflang={target.lang}
  lang={target.lang}
>
  <span class="pill">
    <Globe size={15} />
    {target.label}
  </span>
</a>

<style>
  /* A small outlined pill, so it reads as a setting rather than a page in the nav.
     The link keeps a 44px touch area around the smaller visual pill. */
  .lang {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: var(--control-height);
    color: var(--text-3);
    font-size: 13px;
  }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    height: 30px;
    padding: 0 11px 0 9px;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    transition:
      border-color 0.15s ease,
      color 0.15s ease;
  }
  .lang:hover .pill {
    border-color: var(--border-strong);
    color: var(--text);
  }
</style>
