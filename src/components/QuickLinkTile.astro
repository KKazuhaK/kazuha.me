---
import { BookOpen, FileText, LayoutGrid, Link } from '@lucide/astro';
import Arrow from './Arrow.astro';
import ExternalIcon from './ExternalIcon.astro';

type IconName = 'grid' | 'doc' | 'book' | 'link';

interface Props {
  href: string;
  title: string;
  sub: string;
  action: string;
  icon: IconName;
  external?: boolean;
}

const { href, title, sub, action, icon, external = false } = Astro.props;

const icons = {
  grid: LayoutGrid,
  doc: FileText,
  book: BookOpen,
  link: Link,
} satisfies Record<IconName, unknown>;
const Icon = icons[icon];
---

<a
  class="tile"
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener' : undefined}
>
  <span class="icon">
    <Icon size={22} />
  </span>
  <span class="text">
    <span class="title">{title}</span>
    <span class="sub">{sub}</span>
  </span>
  <span class="action">
    {action}
    {external ? <ExternalIcon /> : <Arrow />}
  </span>
</a>

<style>
  .tile {
    display: flex;
    flex-direction: column;
    gap: 12px;
    height: 100%;
    padding: 22px;
    background: var(--surface);
    border: 1.5px solid var(--border);
    border-radius: var(--radius-card);
    transition:
      border-color 0.15s ease,
      transform 0.15s ease;
  }
  .tile:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: var(--accent-soft);
    color: var(--accent);
  }
  .text {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .title {
    font-size: 18px;
    font-weight: 600;
    line-height: 1.3;
  }
  .sub {
    font-size: 14px;
    color: var(--text-3);
  }
  .action {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-top: auto;
    font-size: 14px;
    font-weight: 600;
    color: var(--accent);
  }
  @media (max-width: 859.98px) {
    .tile {
      gap: 6px;
      padding: 14px;
    }
    .sub {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .tile {
      transition: none;
    }
    .tile:hover {
      transform: none;
    }
  }
</style>
