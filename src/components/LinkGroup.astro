---
interface Props {
  title: string;
  /** Language of the title when it differs from the page. */
  lang?: string;
}

const { title, lang } = Astro.props;
---

<section>
  <h2 {lang}>{title}</h2>
  <div class="rows">
    <slot />
  </div>
</section>

<style>
  h2 {
    margin-bottom: 12px;
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-3);
  }
  .rows {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
</style>
