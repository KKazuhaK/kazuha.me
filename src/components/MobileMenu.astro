---
import ExternalIcon from './ExternalIcon.astro';
import LangSwitch from './LangSwitch.astro';
import LinkButton from './LinkButton.astro';
import type { ResolvedNavItem } from '../config/nav';
import { isPlaceholder, site } from '../config/site';
import { getLocale, localizedPath, t } from '../i18n/ui';

interface Props {
  items: ResolvedNavItem[];
  notFound?: boolean;
}

const { items, notFound = false } = Astro.props;
const locale = getLocale(Astro.currentLocale);
const contactHref = isPlaceholder(site.email)
  ? localizedPath(locale, '/links')
  : `mailto:${site.email}`;
const ICON_OPEN = 'M4 7h16M4 12h16M4 17h16';
const ICON_CLOSE = 'M6 6l12 12M18 6L6 18';
---

<div class="mobile-menu" data-mobile-menu>
  <button
    type="button"
    class="toggle"
    aria-expanded="false"
    aria-controls="mobile-menu"
    data-label-open={t(locale, 'menu')}
    data-label-close={t(locale, 'close')}
    data-icon-open={ICON_OPEN}
    data-icon-close={ICON_CLOSE}
  >
    <svg
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      aria-hidden="true"
      focusable="false"
    >
      <path d={ICON_OPEN} data-icon></path>
    </svg>
    <span data-label>{t(locale, 'menu')}</span>
  </button>

  <div id="mobile-menu" class="panel" hidden>
    <nav aria-label={t(locale, 'navLabel')}>
      {items.map((item) => (
        <a
          href={item.href}
          target={item.external ? '_blank' : undefined}
          rel={item.external ? 'noopener' : undefined}
          class:list={{ active: item.active }}
          aria-current={item.active ? 'page' : undefined}
        >
          <span>{item.mobileLabel}</span>
          {item.external && (
            <span class="aside">
              <ExternalIcon size={13} />
            </span>
          )}
        </a>
      ))}
    </nav>
    <LangSwitch class="panel-lang" notFound={notFound} />
    <LinkButton href={contactHref} variant="accent" size="lg" class="contact">
      {t(locale, 'contactMe')}
    </LinkButton>
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-mobile-menu]');
  const button = root?.querySelector<HTMLButtonElement>('.toggle');
  const panel = root?.querySelector<HTMLElement>('#mobile-menu');
  const label = button?.querySelector<HTMLElement>('[data-label]');
  const icon = button?.querySelector<SVGPathElement>('[data-icon]');

  if (button && panel && label && icon) {
    const setOpen = (open: boolean) => {
      panel.hidden = !open;
      button.setAttribute('aria-expanded', String(open));
      label.textContent = open
        ? button.dataset.labelClose!
        : button.dataset.labelOpen!;
      icon.setAttribute(
        'd',
        open ? button.dataset.iconClose! : button.dataset.iconOpen!,
      );
    };

    button.addEventListener('click', () => setOpen(panel.hidden === true));

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !panel.hidden) {
        setOpen(false);
        button.focus();
      }
    });
  }
</script>

<style>
  .mobile-menu {
    display: none;
  }
  .toggle {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: var(--control-height);
    padding: 0 16px;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-btn);
    background: var(--surface);
    color: var(--text);
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
  }
  .panel {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    z-index: 10;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-1) var(--gutter) var(--space-2);
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    box-shadow: var(--shadow-menu);
  }
  .panel:not([hidden]) {
    display: flex;
  }
  nav {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 16px;
  }
  nav a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: var(--control-height-lg);
    padding: 0 14px;
    border-radius: var(--radius-btn);
    color: var(--text);
  }
  nav a:hover {
    background: var(--surface-hover);
  }
  nav a.active {
    background: var(--accent-soft);
    color: var(--accent);
    font-weight: 600;
  }
  .aside {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 13px;
    font-weight: 400;
    color: var(--text-3);
  }
  .panel :global(.panel-lang) {
    align-self: flex-start;
  }
  .panel :global(.contact) {
    width: 100%;
  }
  @media (max-width: 859.98px) {
    .mobile-menu {
      display: block;
    }
  }
</style>
